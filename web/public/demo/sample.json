}},"answerKeySource":{"type":"upload","count":30,"fileName":"27DaeSuneung_2a.pdf","appliedAt":"2026-11-22T05:40:36.697Z"}},"runs":[{"id":"sample_run_1","mode":"live","note":"","model":"Claude Opus 5.5 (실시간)","trace":[{"t":0,"no":1,"kind":"start","text":""},{"t":0,"no":1,"kind":"page","text":"1-1"},{"t":2688,"no":1,"kind":"page","text":"1-1"},{"t":2688,"no":1,"kind":"step","text":"두 수를 모두 밑이 2인 거듭제곱으로 바꾼다."},{"t":2890,"no":1,"kind":"work","text":"32의 세제곱근 = 2^(5/3), 4^(-1/3) = 2^(-2/3)"},{"t":3138,"no":1,"kind":"step","text":"지수법칙으로 지수를 더해 값을 구한다."},{"t":3431,"no":1,"kind":"work","text":"2^(5/3) × 2^(-2/3) = 2^(5/3 - 2/3) = 2^1 = 2"},{"t":3483,"no":1,"kind":"answer","text":"2"},{"t":3483,"no":1,"kind":"end","text":""},{"t":3483,"no":2,"kind":"start","text":""},{"t":3483,"no":2,"kind":"page","text":"1-1"},{"t":10986,"no":2,"kind":"page","text":"1-1"},{"t":10986,"no":2,"kind":"step","text":"주어진 극한은 미분계수의 정의이므로 f'(1)과 같다."},{"t":10986,"no":2,"kind":"work","text":"lim (h→0) {f(1+h)-f(1)}/h = f'(1)"},{"t":10986,"no":2,"kind":"step","text":"f(x)를 미분한 뒤 x=1을 대입한다."},{"t":11064,"no":2,"kind":"work","text":"f'(x) = 8x^3 + 2, f'(1) = 8 + 2 = 10"},{"t":11128,"no":2,"kind":"answer","text":"5"},{"t":11128,"no":2,"kind":"end","text":""},{"t":11128,"no":3,"kind":"start","text":""},{"t":11128,"no":3,"kind":"page","text":"1-1"},{"t":15041,"no":3,"kind":"page","text":"1-1"},{"t":15041,"no":3,"kind":"step","text":"등비수열의 공비를 r로 놓고 a5 = 3a3에서 r^2을 구한다."},{"t":15041,"no":3,"kind":"work","text":"a1 r^4 = 3 a1 r^2 이므로 r^2 = 3 (모든 항이 양수)"},{"t":15042,"no":3,"kind":"step","text":"일반항으로 a7을 계산한다."},{"t":15164,"no":3,"kind":"work","text":"a7 = a1 r^6 = (r^2)^3 = 3^3 = 27"},{"t":15208,"no":3,"kind":"answer","text":"3"},{"t":15208,"no":3,"kind":"end","text":""},{"t":15208,"no":4,"kind":"start","text":""},{"t":15208,"no":4,"kind":"page","text":"1-1"},{"t":18605,"no":4,"kind":"page","text":"1-1"},{"t":19004,"no":4,"kind":"step","text":"그래프에서 x가 0으로 왼쪽에서 다가갈 때의 극한값을 읽는다."},{"t":19512,"no":4,"kind":"work","text":"-1 < x < 0 구간의 곡선이 열린 점 (0, 3)으로 다가가므로 lim(x→0-) f(x) = 3"},{"t":19874,"no":4,"kind":"step","text":"그래프에서 x가 1로 오른쪽에서 다가갈 때의 극한값을 읽고 두 값을 더한다."},{"t":20317,"no":4,"kind":"work","text":"x > 1 구간의 직선이 점 (1, 1)에서 시작하므로 lim(x→1+) f(x) = 1, 합은 3 + 1 = 4"},{"t":20361,"no":4,"kind":"answer","text":"4"},{"t":20361,"no":4,"kind":"end","text":""},{"t":20361,"no":5,"kind":"start","text":""},{"t":20361,"no":5,"kind":"page","text":"1-2"},{"t":22881,"no":5,"kind":"page","text":"1-2"},{"t":23235,"no":5,"kind":"step","text":"정적분의 값은 부정적분 F(x)의 끝값 차이로 구한다."},{"t":23482,"no":5,"kind":"work","text":"∫(0→2) f(x)dx = F(2) − F(0)"},{"t":23931,"no":5,"kind":"step","text":"F(x) = x^3 − x^2 + x 에 x = 2와 x = 0을 대입해 계산한다."},{"t":24240,"no":5,"kind":"work","text":"F(2) = 8 − 4 + 2 = 6, F(0) = 0 이므로 6 − 0 = 6"},{"t":24284,"no":5,"kind":"answer","text":"1"},{"t":24285,"no":5,"kind":"end","text":""},{"t":24285,"no":6,"kind":"start","text":""},{"t":24285,"no":6,"kind":"page","text":"1-2"},{"t":27873,"no":6,"kind":"page","text":"1-2"},{"t":27873,"no":6,"kind":"step","text":"사인함수의 주기 공식으로 k를 구한다."},{"t":28599,"no":6,"kind":"work","text":"주기 = 2π ÷ (2π/k) = k = 8 이므로 k = 8"},{"t":28614,"no":6,"kind":"step","text":"sin 값의 최댓값이 1임을 이용해 f(x)의 최댓값을 구한다."},{"t":28818,"no":6,"kind":"work","text":"최댓값 = 3×1 + 8 = 11"},{"t":28864,"no":6,"kind":"answer","text":"1"},{"t":28864,"no":6,"kind":"end","text":""},{"t":28864,"no":7,"kind":"start","text":""},{"t":28864,"no":7,"kind":"page","text":"1-2"},{"t":37150,"no":7,"kind":"page","text":"1-2"},{"t":37226,"no":7,"kind":"step","text":"x=1에서 극소이므로 f'(1)=0을 이용해 a를 구한다."},{"t":37474,"no":7,"kind":"work","text":"f'(x)=3x^2+2ax-3a, f'(1)=3+2a-3a=0 이므로 a=3"},{"t":38250,"no":7,"kind":"step","text":"도함수를 인수분해하여 극대가 되는 x를 찾는다."},{"t":38250,"no":7,"kind":"work","text":"f'(x)=3x^2+6x-9=3(x+3)(x-1) 이므로 x=-3에서 극대"},{"t":38281,"no":7,"kind":"step","text":"극댓값 f(-3)을 계산한다."},{"t":38624,"no":7,"kind":"work","text":"f(-3)=-27+27+27+1=28 (홀수형 선지 ②)"},{"t":38674,"no":7,"kind":"answer","text":"2"},{"t":38674,"no":7,"kind":"end","text":""},{"t":38674,"no":8,"kind":"start","text":""},{"t":38674,"no":8,"kind":"page","text":"1-3"},{"t":42138,"no":8,"kind":"page","text":"1-3"},{"t":42338,"no":8,"kind":"step","text":"역수 성질로 1/log_8 3을 밑이 3인 로그로 바꾸어 b를 정리한다."},{"t":43016,"no":8,"kind":"work","text":"b = log_3 2 + log_3 8 = log_3 16 = 4 log_3 2"},{"t":43046,"no":8,"kind":"step","text":"a도 같은 방식으로 나타낸 뒤 두 값을 곱한다."},{"t":43246,"no":8,"kind":"work","text":"a × b = 2 log_2 3 × 4 log_3 2 = 8"},{"t":43291,"no":8,"kind":"answer","text":"3"},{"t":43291,"no":8,"kind":"end","text":""},{"t":43291,"no":9,"kind":"start","text":""},{"t":43291,"no":9,"kind":"page","text":"1-3"},{"t":47056,"no":9,"kind":"page","text":"1-3"},{"t":47223,"no":9,"kind":"step","text":"속도를 인수분해해서 운동 방향이 바뀌는 시각을 찾는다."},{"t":47718,"no":9,"kind":"work","text":"v(t) = 3t^2 - 18t + 15 = 3(t-1)(t-5)이므로 0≤t≤2에서는 t=1에서 부호가 바뀐다."},{"t":47917,"no":9,"kind":"step","text":"구간을 나누어 속도의 절댓값을 적분한다."},{"t":48565,"no":9,"kind":"work","text":"0부터 1까지 적분하면 [t^3 - 9t^2 + 15t] = 7, 1부터 2까지 적분하면 2 - 7 = -5이다."},{"t":48722,"no":9,"kind":"step","text":"두 구간의 이동 거리를 더한다."},{"t":48923,"no":9,"kind":"work","text":"움직인 거리 = 7 + |-5| = 12"},{"t":48967,"no":9,"kind":"answer","text":"4"},{"t":48968,"no":9,"kind":"end","text":""},{"t":48968,"no":10,"kind":"start","text":""},{"t":48968,"no":10,"kind":"page","text":"1-3"},{"t":53211,"no":10,"kind":"page","text":"1-3"},{"t":53613,"no":10,"kind":"step","text":"사인법칙으로 두 변의 비를 정하고 외접원의 넓이에서 반지름을 구한다."},{"t":54017,"no":10,"kind":"work","text":"a:b = 3:4이므로 a = 3k, b = 4k이고, πR² = 17π에서 R = √17"},{"t":54173,"no":10,"kind":"step","text":"코사인법칙으로 c를 k로 나타낸다."},{"t":54574,"no":10,"kind":"work","text":"c² = 9k² + 16k² − 2·3k·4k·(1/3) = 17k²이므로 c = √17·k"},{"t":54866,"no":10,"kind":"step","text":"sinC를 구해 사인법칙 c = 2R·sinC로 k를 구한다."},{"t":55314,"no":10,"kind":"work","text":"sinC = 2√2/3이므로 √17·k = 2√17·(2√2/3), k = 4√2/3, BC = 3k = 4√2"},{"t":55373,"no":10,"kind":"answer","text":"2"},{"t":55373,"no":10,"kind":"end","text":""},{"t":55373,"no":11,"kind":"start","text":""},{"t":55373,"no":11,"kind":"page","text":"1-4"},{"t":59159,"no":11,"kind":"page","text":"1-4"},{"t":59297,"no":11,"kind":"step","text":"접점 (1, f(1))이 접선 위에 있으므로 x=1을 대입해 f(1)을 구한다."},{"t":59658,"no":11,"kind":"work","text":"1^2 × f(1) = 7×1 - 11 이므로 f(1) = -4"},{"t":60007,"no":11,"kind":"step","text":"y = x^2 f(x)를 미분하고, x=1에서의 미분계수가 접선의 기울기 7과 같다는 식을 세운다."},{"t":60458,"no":11,"kind":"work","text":"y' = 2x f(x) + x^2 f'(x) 이므로 2f(1) + f'(1) = 7"},{"t":60501,"no":11,"kind":"step","text":"f(1) = -4를 대입하여 f'(1)을 구한다."},{"t":60715,"no":11,"kind":"work","text":"-8 + f'(1) = 7 이므로 f'(1) = 15"},{"t":60758,"no":11,"kind":"answer","text":"5"},{"t":60758,"no":11,"kind":"end","text":""},{"t":60758,"no":12,"kind":"start","text":""},{"t":60758,"no":12,"kind":"page","text":"1-4"},{"t":65064,"no":12,"kind":"page","text":"1-4"},{"t":65249,"no":12,"kind":"step","text":"S8 - S3를 a4부터 a8까지의 합으로 보고 a6을 구한다."},{"t":65641,"no":12,"kind":"work","text":"S8 - S3 = a4+a5+a6+a7+a8 = 5a6 = -15 이므로 a6 = -3"},{"t":65859,"no":12,"kind":"step","text":"a3 = |a8|에서 a8의 부호로 경우를 나눈다."},{"t":66831,"no":12,"kind":"work","text":"a8 ≥ 0이면 a3 = a8이므로 d = 0이 되어 a8 = -3 < 0과 모순이다. 따라서 a3 = -a8이고, a3 + a8 = a5 + a6 = 0에서 a5 = 3, d = -6"},{"t":66958,"no":12,"kind":"step","text":"첫째항을 구한 뒤 S4를 계산한다."},{"t":67309,"no":12,"kind":"work","text":"a1 = a5 - 4d = 3 + 24 = 27이므로 S4 = 27 + 21 + 15 + 9 = 72"},{"t":67358,"no":12,"kind":"answer","text":"3"},{"t":67358,"no":12,"kind":"end","text":""},{"t":67358,"no":13,"kind":"start","text":""},{"t":67358,"no":13,"kind":"page","text":"1-5"},{"t":75483,"no":13,"kind":"page","text":"1-5"},{"t":75822,"no":13,"kind":"step","text":"ㄱ은 f(x)=-x+1을 넣어 g(0)을 직접 계산한다."},{"t":76179,"no":13,"kind":"work","text":"g(0)=∫0~2 |1-x| dx = 1/2+1/2 = 1 이므로 ㄱ은 참이다."},{"t":76739,"no":13,"kind":"step","text":"ㄴ은 f(x)+3의 부호가 x=1에서 바뀌는 것을 이용해 적분 구간을 나눈다."},{"t":77434,"no":13,"kind":"work","text":"f(x)+3=(x-1)(x-3)이므로 g(-3)=∫0~1 (f+3)dx - ∫1~2 (f+3)dx = ∫0~1 f dx - ∫1~2 f dx 이고, ㄴ은 참이다."},{"t":78082,"no":13,"kind":"step","text":"ㄷ은 [0,2]에서 f가 감소함수이므로 g(t)가 볼록함수임을 이용해 최솟값과 α를 비교한다."},{"t":79422,"no":13,"kind":"work","text":"f'(x)=3x^2-8x<0 (0<x≤2)이다. f(c)=t일 때 g'(t)=2-2c이므로 g는 t=f(1)에서만 최소이고, 그 최솟값이 ∫0~1 f dx - ∫1~2 f dx 이다. 따라서 α=f(1)이고 ㄷ은 거짓이다."},{"t":79475,"no":13,"kind":"answer","text":"2"},{"t":79475,"no":13,"kind":"end","text":""},{"t":79475,"no":14,"kind":"start","text":""},{"t":79475,"no":14,"kind":"page","text":"1-5"},{"t":84799,"no":14,"kind":"page","text":"1-5"},{"t":85493,"no":14,"kind":"step","text":"g(x) = f(x+6) + 1이므로 기울기가 -1/6인 직선은 P를 (-6, +1)만큼 옮긴 점을 지납니다. 따라서 Q를 구할 수 있습니다."},{"t":85943,"no":14,"kind":"work","text":"Q = (5-6, 1+1) = (-1, 2)이고, 확인하면 g(-1) = log_a 1 + 2 = 2입니다."},{"t":86391,"no":14,"kind":"step","text":"R = (r, -2r+11)로 두고, 무게중심이 y = 2x 위에 있다는 조건으로 r을 구합니다."},{"t":86790,"no":14,"kind":"work","text":"(14-2r)/3 = 2(4+r)/3에서 14-2r = 8+2r이므로 r = 3/2, R = (3/2, 8)입니다."},{"t":87042,"no":14,"kind":"step","text":"R이 곡선 y = g(x) 위에 있으므로 a^6을 구합니다."},{"t":87394,"no":14,"kind":"work","text":"log_a(7/2) + 2 = 8에서 log_a(7/2) = 6이므로 a^6 = 7/2입니다."},{"t":87446,"no":14,"kind":"answer","text":"4"},{"t":87446,"no":14,"kind":"end","text":""},{"t":87446,"no":15,"kind":"start","text":""},{"t":87446,"no":15,"kind":"page","text":"1-6"},{"t":97256,"no":15,"kind":"page","text":"1-6"},{"t":97900,"no":15,"kind":"step","text":"f(x)를 인수분해해 각 구간에서 f의 부호를 구하고, 우극한 lim f(t)/|f(t)|의 값을 정한다."},{"t":98475,"no":15,"kind":"work","text":"f(x)=x(x-1)(x-4)이므로 우극한 값은 x<0에서 -1, 0≤x<1에서 1, 1≤x<4에서 -1, x≥4에서 1"},{"t":98998,"no":15,"kind":"step","text":"g(x^2)에서 부호가 바뀌는 지점 x^2=0, 1, 4를 조사하되, 2x^2-6≠0인 곳만 불연속이다."},{"t":99708,"no":15,"kind":"work","text":"x^2=0에서는 양쪽 모두 1이라 연속이고, x^2=1, 4에서는 2x^2-6≠0이라 불연속이므로 a = -2, -1, 1, 2 (n=4)"},{"t":99860,"no":15,"kind":"step","text":"a3=1을 g에 대입한다."},{"t":100159,"no":15,"kind":"work","text":"g(1)=(2-6)×(-1)=4이므로 n+g(a3)=4+4=8"},{"t":100210,"no":15,"kind":"answer","text":"3"},{"t":100210,"no":15,"kind":"end","text":""},{"t":100210,"no":16,"kind":"start","text":""},{"t":100210,"no":16,"kind":"page","text":"1-6"},{"t":103778,"no":16,"kind":"page","text":"1-6"},{"t":103778,"no":16,"kind":"step","text":"양변의 밑을 5로 통일한다."},{"t":103778,"no":16,"kind":"work","text":"(1/25)^(x-3) = 5^(-2(x-3)) = 5^(-2x+6)"},{"t":103779,"no":16,"kind":"step","text":"지수끼리 같다고 놓고 x를 구한다."},{"t":103905,"no":16,"kind":"work","text":"x = -2x + 6, 3x = 6, x = 2"},{"t":103949,"no":16,"kind":"answer","text":"2"},{"t":103949,"no":16,"kind":"end","text":""},{"t":103949,"no":17,"kind":"start","text":""},{"t":103949,"no":17,"kind":"page","text":"1-6"},{"t":106472,"no":17,"kind":"page","text":"1-6"},{"t":106673,"no":17,"kind":"step","text":"도함수 f'(x)를 적분해 f(x)를 구한다."},{"t":106780,"no":17,"kind":"work","text":"f(x) = 2x^3 + x + C"},{"t":107074,"no":17,"kind":"step","text":"f(1) = 5를 대입해 적분상수 C를 구한다."},{"t":107428,"no":17,"kind":"work","text":"2 + 1 + C = 5 이므로 C = 2, f(x) = 2x^3 + x + 2"},{"t":107524,"no":17,"kind":"step","text":"x = 2를 대입한다."},{"t":107677,"no":17,"kind":"work","text":"f(2) = 16 + 2 + 2 = 20"},{"t":107726,"no":17,"kind":"answer","text":"20"},{"t":107726,"no":17,"kind":"end","text":""},{"t":107726,"no":18,"kind":"start","text":""},{"t":107726,"no":18,"kind":"page","text":"1-7"},{"t":111657,"no":18,"kind":"page","text":"1-7"},{"t":111657,"no":18,"kind":"step","text":"좌변의 시그마를 항별로 나누어 계산한다."},{"t":111657,"no":18,"kind":"work","text":"2×(1+2+3+4+5) + 5a = 30 + 5a"},{"t":111657,"no":18,"kind":"step","text":"우변의 제곱의 합을 구하고, 두 식을 같게 놓아 a를 구한다."},{"t":111724,"no":18,"kind":"work","text":"5×6×11/6 = 55 이므로 30 + 5a = 55, a = 5"},{"t":111761,"no":18,"kind":"answer","text":"5"},{"t":111761,"no":18,"kind":"end","text":""},{"t":111761,"no":19,"kind":"start","text":""},{"t":111761,"no":19,"kind":"page","text":"1-7"},{"t":114932,"no":19,"kind":"page","text":"1-7"},{"t":115290,"no":19,"kind":"step","text":"f(x)=x^3-3x^2-24x+3을 미분해 극값을 갖는 x를 찾는다."},{"t":115678,"no":19,"kind":"work","text":"f'(x)=3x^2-6x-24=3(x-4)(x+2)=0에서 x=-2 또는 x=4"},{"t":116140,"no":19,"kind":"step","text":"직선 y=k와 두 점에서 만나려면 k가 극댓값 또는 극솟값과 같아야 하므로 두 극값을 구한다."},{"t":116430,"no":19,"kind":"work","text":"극댓값 f(-2)=-8-12+48+3=31, 극솟값 f(4)=64-48-96+3=-77"},{"t":116693,"no":19,"kind":"step","text":"두 극값 중 양수인 것을 k로 고른다."},{"t":116832,"no":19,"kind":"work","text":"k>0이므로 k=31"},{"t":116882,"no":19,"kind":"answer","text":"31"},{"t":116882,"no":19,"kind":"end","text":""},{"t":116882,"no":20,"kind":"start","text":""},{"t":116882,"no":20,"kind":"page","text":"1-7"},{"t":131709,"no":20,"kind":"page","text":"1-7"},{"t":131709,"no":20,"kind":"step","text":"두 교점 A, B를 지나는 직선 l의 기울기를 근과 계수의 관계로 구한다."},{"t":131807,"no":20,"kind":"work","text":"기울기 = x1 + x2 - 2(b+1) = 2b - 2b - 2 = -2이므로 p = -2이다."},{"t":131834,"no":20,"kind":"step","text":"직선 l의 식으로 y1을 x1에 대한 식으로 나타내 기울기 합의 조건에 대입한다."},{"t":131834,"no":20,"kind":"work","text":"y1 = 2(b - x1)이고 4(b - x1)^2 / (x1(2b - x1)) = 100/11이므로 36x1^2 - 72bx1 + 11b^2 = 0이다. x1 < b이므로 x1 = b/6, 따라서 q = 1/6이다."},{"t":131962,"no":20,"kind":"step","text":"점 A가 곡선 y = f(x) 위에 있음을 이용해 a를 b로 나타낸다."},{"t":131962,"no":20,"kind":"work","text":"f(b/6) = a sin(π/6) = a/2 = 5b/3이므로 a = 10b/3, h(9) = 30이다. 따라서 6(p + q + h(9)) = 6(-2 + 1/6 + 30) = 169이다."},{"t":131965,"no":20,"kind":"answer","text":"169"},{"t":131965,"no":20,"kind":"end","text":""},{"t":131965,"no":21,"kind":"start","text":""},{"t":131965,"no":21,"kind":"page","text":"1-8"},{"t":165779,"no":21,"kind":"page","text":"1-8"},{"t":167276,"no":21,"kind":"step","text":"g(t)를 M(t)×m(t)로 놓습니다. M(t)는 (-∞, t]에서의 최댓값, m(t)는 [t, ∞)에서의 최솟값입니다. f의 극대점을 α, 극소점을 β라 하면 [α, β]에서 g는 상수이고, g가 미분불가능한 점은 t0(t0<α, f(t0)=f(β))와 t1(t1>β, f(t1)=f(α))뿐입니다."},{"t":167722,"no":21,"kind":"work","text":"t0에서 (좌미분-우미분) = f(β)f'(t0), t1에서 (좌미분-우미분) = -f(α)f'(t1)"},{"t":169081,"no":21,"kind":"step","text":"(가)에서 이 값이 양수 36이 되려면 f(α)<0이어야 하고, 이때 a=t1입니다. f(α)<0이면 g'=0인 b는 구간 [α, β]와 t1보다 큰 f의 근 r입니다. f(β)>0인 경우를 따져 보면 조건에 맞는 해가 없습니다."},{"t":169575,"no":21,"kind":"work","text":"(나)에서 α=-1, r=2이므로 f(x)=(x+1)²(x-u)+k (u=t1, k=f(-1)), f(2)=0에서 k=9(u-2)"},{"t":170023,"no":21,"kind":"step","text":"(가)의 조건 -k(u+1)²=36을 풀어 u를 구합니다. u>0, t1>β를 확인합니다."},{"t":170576,"no":21,"kind":"work","text":"9(2-u)(u+1)²=36 → u³-3u+2=0 → (u-1)²(u+2)=0 → u=1, k=-9, β=1/3<1=t1, f(x)=(x+1)²(x-1)-9"},{"t":170730,"no":21,"kind":"step","text":"f(5)를 계산합니다."},{"t":170823,"no":21,"kind":"work","text":"f(5)=36×4-9=135"},{"t":170873,"no":21,"kind":"answer","text":"135"},{"t":170873,"no":21,"kind":"end","text":""},{"t":170873,"no":22,"kind":"start","text":""},{"t":170873,"no":22,"kind":"page","text":"1-8"},{"t":177202,"no":22,"kind":"page","text":"1-8"},{"t":177788,"no":22,"kind":"step","text":"a_n = a_(n+6) = a_(n+9)에서 주기를 구해 수열을 세 값 a1, a2, a3로 나타낸다."},{"t":178189,"no":22,"kind":"work","text":"gcd(6, 9) = 3이므로 주기 3, a5 = a2, a6 = a3, a10 = a1"},{"t":178389,"no":22,"kind":"step","text":"조건 (가)와 합의 조건에서 a1+a2와 a3을 구한다."},{"t":178789,"no":22,"kind":"work","text":"3(a1+a2) + 2a3 = 11, 7(a1+a2) + 6a3 = 26 → a1+a2 = 7/2, a3 = 1/4"},{"t":179050,"no":22,"kind":"step","text":"로그 합의 조건에서 a1·a2를 구한다."},{"t":179392,"no":22,"kind":"work","text":"11·log2(a1a2a3) + log2(a1a2) = -10 → 12·log2(a1a2) - 22 = -10 → a1a2 = 2"},{"t":179701,"no":22,"kind":"step","text":"한 주기의 합을 구한 뒤 40개 항의 합으로 확장한다."},{"t":180398,"no":22,"kind":"work","text":"한 주기 합 = (a1+a2+a3)/(a1a2a3) = (15/4)/(1/2) = 15/2, k=1~39는 13주기, k=40은 1/(a1a2) = 1/2 → 13×15/2 + 1/2 = 98"},{"t":180446,"no":22,"kind":"answer","text":"98"},{"t":180446,"no":22,"kind":"end","text":""},{"t":180446,"no":23,"kind":"start","text":""},{"t":180446,"no":23,"kind":"page","text":"1-9"},{"t":184276,"no":23,"kind":"page","text":"1-9"},{"t":184689,"no":23,"kind":"step","text":"a, b 두 문자 중 중복을 허용해 7개를 택해 일렬로 나열하므로 중복순열로 센다."},{"t":185029,"no":23,"kind":"work","text":"경우의 수 = 2П7 = 2^7"},{"t":185184,"no":23,"kind":"step","text":"거듭제곱을 계산해 해당 선지를 찾는다."},{"t":185341,"no":23,"kind":"work","text":"2^7 = 128 → ③"},{"t":185390,"no":23,"kind":"answer","text":"3"},{"t":185390,"no":23,"kind":"end","text":""},{"t":185390,"no":24,"kind":"start","text":""},{"t":185390,"no":24,"kind":"page","text":"1-9"},{"t":190656,"no":24,"kind":"page","text":"1-9"},{"t":191412,"no":24,"kind":"step","text":"24번이 여러 선택과목에 있으므로 파일에서 처음 나오는 홀수형 확률과 통계 24번을 풀고, 합사건 확률 공식으로 교사건의 확률을 구한다."},{"t":191659,"no":24,"kind":"work","text":"P(A∩B) = P(A) + P(B) - P(A∪B)"},{"t":191814,"no":24,"kind":"step","text":"주어진 값을 대입하여 계산한다."},{"t":192158,"no":24,"kind":"work","text":"1/2 + 5/12 - 3/4 = 6/12 + 5/12 - 9/12 = 2/12 = 1/6"},{"t":192210,"no":24,"kind":"answer","text":"2"},{"t":192210,"no":24,"kind":"end","text":""},{"t":192210,"no":25,"kind":"start","text":""},{"t":192210,"no":25,"kind":"page","text":"1-10"},{"t":196009,"no":25,"kind":"page","text":"1-10"},{"t":196660,"no":25,"kind":"step","text":"25번은 선택과목마다 있으므로 첫 번째로 나오는 홀수형 확률과 통계 25번을 풀고, 표준편차로 분산 식을 세워 n을 구한다."},{"t":197062,"no":25,"kind":"work","text":"V(X) = n × (2/3) × (1/3) = 2n/9 = 4² = 16 이므로 n = 72"},{"t":197218,"no":25,"kind":"step","text":"평균을 구해 n과 더한다."},{"t":197513,"no":25,"kind":"work","text":"E(X) = 72 × 2/3 = 48 이므로 n + E(X) = 72 + 48 = 120"},{"t":197565,"no":25,"kind":"answer","text":"5"},{"t":197565,"no":25,"kind":"end","text":""},{"t":197565,"no":26,"kind":"start","text":""},{"t":197565,"no":26,"kind":"page","text":"1-10"},{"t":202816,"no":26,"kind":"page","text":"1-10"},{"t":203524,"no":26,"kind":"step","text":"26번은 선택과목마다 있으므로, 첫 선택과목인 확률과 통계 26번(홀수형)을 풀고 여사건 ab ≤ 4 또는 ab ≥ 29인 경우를 센다."},{"t":204022,"no":26,"kind":"work","text":"ab ≤ 4인 순서쌍은 (1,1),(1,2),(1,3),(1,4),(2,1),(2,2),(3,1),(4,1)로 8가지이다."},{"t":204373,"no":26,"kind":"step","text":"곱이 29 이상인 순서쌍을 센다."},{"t":204667,"no":26,"kind":"work","text":"ab ≥ 29인 순서쌍은 (5,6),(6,5),(6,6)으로 3가지이다."},{"t":204974,"no":26,"kind":"step","text":"전체 36가지에서 여사건의 경우를 빼서 확률을 구한다."},{"t":205114,"no":26,"kind":"work","text":"(36 - 8 - 3)/36 = 25/36"},{"t":205165,"no":26,"kind":"answer","text":"5"},{"t":205165,"no":26,"kind":"end","text":""},{"t":205165,"no":27,"kind":"start","text":""},{"t":205165,"no":27,"kind":"page","text":"1-11"},{"t":209409,"no":27,"kind":"page","text":"1-11"},{"t":209704,"no":27,"kind":"step","text":"신뢰구간 양 끝의 평균으로 표본평균을 구한다."},{"t":209906,"no":27,"kind":"work","text":"x̄ = (252.16 + 267.84) / 2 = 260"},{"t":210460,"no":27,"kind":"step","text":"신뢰구간 길이의 절반이 1.96 × σ/√64 임을 이용해 σ를 구한다."},{"t":210862,"no":27,"kind":"work","text":"1.96 × σ/8 = 7.84 이므로 σ = 32, x̄ + σ = 260 + 32 = 292"},{"t":210899,"no":27,"kind":"answer","text":"1"},{"t":210899,"no":27,"kind":"end","text":""},{"t":210899,"no":28,"kind":"start","text":""},{"t":210899,"no":28,"kind":"page","text":"1-11"},{"t":220888,"no":28,"kind":"page","text":"1-11"},{"t":221399,"no":28,"kind":"step","text":"확률과 통계 28번으로 보고, 이웃한 두 카드가 조건을 어기는 경우를 찾는다."},{"t":222142,"no":28,"kind":"work","text":"1/2×1=1/2만 자연수가 아니면서 두 수가 다르다. 따라서 1/2과 1만 이웃하면 안 된다. (1/2×1/2은 두 수가 같아 가능)"},{"t":222744,"no":28,"kind":"step","text":"1/2, 1/2, 2, 2, 2, 4를 먼저 나열하고, 1/2에 붙지 않는 틈에 1 세 장을 넣는다."},{"t":223442,"no":28,"kind":"work","text":"1/2 두 장이 이웃하면 넣을 수 있는 틈이 4개, 떨어져 있으면 3개이다. 이 두 경우를 나누어 센다."},{"t":224048,"no":28,"kind":"step","text":"1/2의 위치 쌍마다 1을 넣는 방법의 수를 더하고, 2, 2, 2, 4의 배열 4가지를 곱한다."},{"t":224391,"no":28,"kind":"work","text":"{5×C(6,3) + 10×C(5,3)}×4 = (100+100)×4 = 800"},{"t":224441,"no":28,"kind":"answer","text":"3"},{"t":224441,"no":28,"kind":"end","text":""},{"t":224441,"no":29,"kind":"start","text":""},{"t":224441,"no":29,"kind":"page","text":"1-12"},{"t":230641,"no":29,"kind":"page","text":"1-12"},{"t":230939,"no":29,"kind":"step","text":"확률의 합으로 a와 b의 관계를 구한다."},{"t":231344,"no":29,"kind":"work","text":"2a^2 + 2b + 2a = 1 이므로 b = 1/2 - a - a^2 (b ≥ 0)"},{"t":231641,"no":29,"kind":"step","text":"분포가 대칭이므로 평균은 0이고, 조건에서 분산을 정한다."},{"t":232092,"no":29,"kind":"work","text":"E(X) = 0, V(X) = 2k^2(9a^2 + 4b + a), 1 ≤ V ≤ √V 이므로 V(X) = 1"},{"t":232542,"no":29,"kind":"step","text":"k^2이 최대가 되려면 9a^2 + 4b + a가 최소여야 하므로 그 최솟값을 구한다."},{"t":233190,"no":29,"kind":"work","text":"9a^2 + 4b + a = 5a^2 - 3a + 2, a = 3/10에서 최소 31/20 (이때 b = 11/100 ≥ 0), k^2 = 1/(2 × 31/20) = 10/31"},{"t":233242,"no":29,"kind":"answer","text":"41"},{"t":233242,"no":29,"kind":"end","text":""},{"t":233242,"no":30,"kind":"start","text":""},{"t":233242,"no":30,"kind":"page","text":"1-12"},{"t":243042,"no":30,"kind":"page","text":"1-12"},{"t":244296,"no":30,"kind":"step","text":"첫 번째 파일에는 30번이 세 과목(확률과 통계, 미적분, 기하)에 모두 있어서, 처음 나오는 확률과 통계 30번(1-12쪽)을 풀었다. 먼저 6장에서 3장을 고르는 20가지 경우를 A, B 해당 여부로 나눈다."},{"t":245039,"no":30,"kind":"work","text":"나머지로 보면 {1,4}≡1, {2,5}≡2, {3,6}≡0이므로 A는 2×2×2=8가지, B는 20−C(4,3)=16가지, A∩B는 8−2=6가지이다."},{"t":245488,"no":30,"kind":"step","text":"한 시행의 점수를 [A]+[B]로 놓고 각 점수가 나오는 경우의 수를 센다."},{"t":246045,"no":30,"kind":"work","text":"점수 2는 6가지, 점수 1은 2+10=12가지, 점수 0은 2가지이다. a+b=4가 되는 점수 조합은 (2,2,0)과 (2,1,1)이다."},{"t":246751,"no":30,"kind":"step","text":"조건부확률로 계산한다. 6이 포함된 10가지 경우는 모두 B에 해당하고, 그중 A에도 해당하는 것은 4가지이다."},{"t":247696,"no":30,"kind":"work","text":"전체는 3·6·6·2 + 3·6·12·12 = 216 + 2592 = 2808이다. 6이 포함되면 점수 0이 나올 수 없으므로 (2,1,1)만 가능하고, 그 경우는 3·4·6·6 = 432이다. 따라서 확률은 432/2808 = 2/13이다."},{"t":247743,"no":30,"kind":"answer","text":"15"},{"t":247743,"no":30,"kind":"end","text":""}],"usage":{"inputTokens":1485,"outputTokens":20406,"cacheReadTokens":2329140},"effort":"medium","errors":{},"isDemo":false,"source":"ai","answers":{"1":{"answer":"2","status":"answered"},"2":{"answer":"5","status":"answered"},"3":{"answer":"3","status":"answered"},"4":{"answer":"4","status":"answered"},"5":{"answer":"1","status":"answered"},"6":{"answer":"1","status":"answered"},"7":{"answer":"2","status":"answered"},"8":{"answer":"3","status":"answered"},"9":{"answer":"4","status":"answered"},"10":{"answer":"2","status":"answered"},"11":{"answer":"5","status":"answered"},"12":{"answer":"3","status":"answered"},"13":{"answer":"2","status":"answered"},"14":{"an